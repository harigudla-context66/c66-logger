# Copy to examples/.env (git-ignored) and fill in. Read by 19_connections_yaml.py.
LOGS_PG_HOST=localhost
LOGS_PG_PORT=5432
LOGS_PG_DATABASE=c66_demo
LOGS_PG_USER=postgres
# Must not be empty (enterprise_connectors treats "" as unset). A local Postgres
# that trusts localhost ignores it, so any placeholder works there.
LOGS_PG_PASSWORD=change-me

# ClickHouse (the demo server: docker run ... clickhouse/clickhouse-server, see DEMO_GUIDE.md)
LOGS_CH_HOST=localhost
LOGS_CH_PORT=8123
LOGS_CH_SECURE=false
LOGS_CH_USER=logs_writer
LOGS_CH_PASSWORD=demo-pass
